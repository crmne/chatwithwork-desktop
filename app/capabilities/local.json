{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local",
  "description": "The bundled settings pages in app-owned child webviews: the daemon through local.rs's allow-list, pairing, folders and the app's settings, with events from the app delivered into the page (windows::tell_settings), so no core permissions. Pages from the network never get this: it names no remote URL or parent window.",
  "webviews": ["computer-pane-main", "computer-pane-page-*"],
  "local": true,
  "permissions": [
    "allow-control",
    "allow-activity",
    "allow-app-info",
    "allow-set-onboarded",
    "allow-pick-folder",
    "allow-pair",
    "allow-cancel-pairing",
    "allow-logout",
    "allow-start-agent",
    "allow-prepare-command-drives",
    "allow-browser-enable",
    "allow-autostart",
    "allow-set-autostart",
    "allow-crash-reports",
    "allow-set-crash-reports",
    "allow-open-file",
    "allow-open-url",
    "allow-show-main",
    "allow-quit",
    "allow-dictation",
    "allow-set-dictation",
    "allow-download-model",
    "allow-cancel-download",
    "allow-update-status",
    "allow-update-check",
    "allow-update-restart",
    "allow-remove-model"
  ]
}
