{
  "name": "chatwithwork-browser",
  "private": true,
  "version": "0.1.3",
  "description": "The Chat with Work browser extension",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "node scripts/build.mjs && node --test \"build-tests/tests/*.test.js\"",
    "e2e": "node scripts/build.mjs && playwright test",
    "package": "node scripts/build.mjs --store",
    "package:unpacked": "node scripts/build.mjs --unpacked",
    "test:package": "node --test scripts/package.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
