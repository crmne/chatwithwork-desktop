{
  "manifest_version": 3,
  "name": "Chat with Work",
  "short_name": "Chat with Work",
  "version": "0.1.3",
  "description": "Lets Chat with Work use tabs in its own tab group, on sites you allow, through Chat with Work Desktop.",
  "homepage_url": "https://chatwithwork.com",
  "minimum_chrome_version": "125",
  "key": "",
  "permissions": ["debugger", "tabs", "tabGroups", "nativeMessaging", "storage", "alarms", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "js/background.js", "type": "module" },
  "action": {
    "default_title": "Chat with Work",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
