{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chat with Work Tauri Prototype",
  "mainBinaryName": "cww-desktop-tauri",
  "version": "0.0.0",
  "identifier": "com.chatwithwork.desktop.tauri-prototype",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Chat with Work",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' cwwasset: http://cwwasset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "app"],
    "category": "Productivity",
    "shortDescription": "Chat with Work Desktop, Tauri prototype",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
