<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key><string>Chat with Work</string>
    <key>CFBundleDisplayName</key><string>Chat with Work</string>
    <key>CFBundleIdentifier</key><string>com.chatwithwork.desktop</string>
    <key>CFBundleExecutable</key><string>cww-app</string>
    <key>CFBundleIconFile</key><string>cww-app</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>__VERSION__</string>
    <key>CFBundleVersion</key><string>__VERSION__</string>
    <!-- Links that open in the app: app/src/links.rs. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key><string>com.chatwithwork.desktop.link</string>
            <key>CFBundleTypeRole</key><string>Viewer</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>chatwithwork</string>
                <string>cww-staging</string>
                <string>cww-dev</string>
            </array>
        </dict>
    </array>
    <key>LSMinimumSystemVersion</key><string>11.0</string>
    <key>LSApplicationCategoryType</key><string>public.app-category.productivity</string>
    <!-- A menu bar app: no Dock icon and no menu bar of its own. -->
    <key>LSUIElement</key><true/>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSMicrophoneUsageDescription</key><string>Dictate a message. Audio is sent through your Chat with Work server for transcription in the EU using credits.</string>
    <key>NSHumanReadableCopyright</key><string>© 2026 Carmine Paolino. GPL-3.0-only. Chat with Work is a trademark of PlentyLabs UG (haftungsbeschränkt) &amp; Co. KG.</string>
</dict>
</plist>
