# systemd user unit for Chat with Work Desktop, installed by the
# distribution packages to /usr/lib/systemd/user/cww.service.
#
#   systemctl --user enable --now cww.service
#
# The worker confines file access with Landlock. Its supervisor creates
# separate MXC sandboxes for commands in the folders the user permits.
#
# Behind an HTTP proxy, set `proxy = "http://proxy.example:3128"` in
# ~/.config/cww/config.toml: services don't see a shell's HTTPS_PROXY.
[Unit]
Description=Chat with Work Desktop (cww)
Documentation=https://github.com/crmne/chatwithwork-desktop
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs outside the sandbox so the directories exist before ReadWritePaths applies.
ExecStartPre=+/usr/bin/mkdir -p -m 0700 %h/.config/cww %h/.local/share/cww %h/.local/state/cww
ExecStart=/usr/bin/cww daemon run
Restart=on-failure
RestartSec=5
RuntimeDirectory=cww
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=%h/.config/cww %h/.local/share/cww %h/.local/state/cww
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# @sandbox is Landlock/seccomp; Bubblewrap also needs its mount namespace.
SystemCallFilter=@system-service @sandbox mount umount2 pivot_root mount_setattr
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
# JIT runtimes inherit this unit, including the fixed bundled browser engine.
# RestrictSUIDSGID blocks openat2, which Bubblewrap uses to resolve mount paths.
# NoNewPrivileges still prevents acquiring privilege through executable bits.
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=default.target
