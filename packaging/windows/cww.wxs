<!--
  Chat with Work Desktop, as a per-user MSI (WiX Toolset 5).

  - Installs cww.exe, cww-app.exe and cww-agent.exe to %LOCALAPPDATA%\Programs\Chat with Work Desktop
    and adds that folder to the user's PATH. Per-user, so no UAC prompt.
  - Installs the app's 32-bit scanner helper beside it, with the TWAIN Working
    Group's TWAINDSM.dll (LGPL-2.1, its licence and notice beside it).
  - Registers the daemon's logon Scheduled Task (`cww daemon install`) and
    starts it; it stays idle until the computer is paired. Uninstalling
    closes the desktop app and removes the task and everything the agent and
    the app kept for this user (`cww daemon uninstall --purge`: shared
    folders, the index, the log, keys, the app's web view data). An upgrade
    only stops the agent (`cww daemon uninstall`), keeping all of it.
  - Start menu shortcuts open the desktop app and the terminal UI.

  Build (see packaging/windows/build-msi.ps1):
    wix build cww.wxs -arch x64 -ext WixToolset.Util.wixext -d Version=1.2.3 -d SourceDir=... -o cww.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
    Name="Chat with Work Desktop"
    Manufacturer="Plenty"
    Version="$(Version)"
    UpgradeCode="{FBC69B33-161E-40DC-9D83-5B54DB1A9821}"
    Scope="perUser"
    Compressed="yes"
    Language="1033"
    Codepage="1252">
    <!-- Never change the UpgradeCode: it ties every version together. -->
    <SummaryInformation Codepage="1252" Description="Chat with Work Desktop (cww)" Manufacturer="Plenty" />
    <MajorUpgrade
      Schedule="afterInstallInitialize"
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/crmne/chatwithwork-desktop" />
    <Property Id="ARPHELPLINK" Value="https://github.com/crmne/chatwithwork-desktop#readme" />
    <Property Id="ARPCOMMENTS" Value="Desktop app, terminal interface and local background agent. Open Chat with Work to finish setup, or run cww daemon install to start the agent." />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Chat with Work Desktop" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- Per-user components use an HKCU value as their key path. -->
    <ComponentGroup Id="Program" Directory="INSTALLFOLDER">
      <Component Id="Binary" Guid="{3212593C-0AB5-418F-A9C7-1D81467F287F}">
        <File Id="CwwExe" Name="cww.exe" Source="$(SourceDir)\cww.exe" KeyPath="no" />
        <!-- The daemon without a console window, for the logon task. -->
        <File Id="CwwAgentExe" Name="cww-agent.exe" Source="$(SourceDir)\cww-agent.exe" KeyPath="no" />
        <RegistryValue Root="HKCU" Key="Software\Chat with Work\Desktop"
          Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <Environment Id="UserPath" Name="PATH" Value="[INSTALLFOLDER]"
          Action="set" Part="last" System="no" Permanent="no" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      </Component>
      <Component Id="DesktopApp" Guid="{6E0392C2-97B4-44DB-B187-FD5ACB2EB2B3}">
        <File Id="CwwAppExe" Name="cww-app.exe" Source="$(SourceDir)\cww-app.exe" KeyPath="no" />
        <RegistryValue Root="HKCU" Key="Software\Chat with Work\Desktop"
          Name="DesktopApp" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <!-- The installer's marker beside cww-app.exe: the app updates itself
           through this package (fastframe-update's WindowsInstaller kind,
           app/src/update.rs) only where it finds it. -->
      <Component Id="UpdateMarker" Guid="{32FDB438-BFF5-4FBE-AEE2-76560754FCF0}">
        <File Id="InstallerMarker" Name="cww-installer.txt" Source="$(SourceDir)\cww-installer.txt" KeyPath="no" />
        <RegistryValue Root="HKCU" Key="Software\Chat with Work\Desktop"
          Name="UpdateMarker" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="Scanning" Guid="{2E0B7C51-6A4D-4F0E-9C3B-8D17F5A2E964}">
        <!-- 32-bit, as most scanners' TWAIN drivers are, on x64 and arm64 alike. -->
        <File Id="ScanHelperExe" Name="cww-scan-helper.exe" Source="$(SourceDir)\cww-scan-helper.exe" KeyPath="no" />
        <File Id="TwainDsm" Name="TWAINDSM.dll" Source="$(SourceDir)\TWAINDSM.dll" KeyPath="no" />
        <File Id="TwainDsmLicense" Name="TWAINDSM-LICENSE.txt" Source="$(SourceDir)\TWAINDSM-LICENSE.txt" KeyPath="no" />
        <File Id="TwainDsmNotice" Name="TWAINDSM-NOTICE.txt" Source="$(SourceDir)\TWAINDSM-NOTICE.txt" KeyPath="no" />
        <RegistryValue Root="HKCU" Key="Software\Chat with Work\Desktop"
          Name="Scanning" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="Documents" Guid="{B62401DF-87F3-4E51-AEB2-16FBAB6544BF}">
        <File Id="Readme" Name="README.md" Source="$(SourceDir)\README.md" KeyPath="no" />
        <File Id="Protocol" Name="PROTOCOL.md" Source="$(SourceDir)\PROTOCOL.md" KeyPath="no" />
        <File Id="Security" Name="SECURITY.md" Source="$(SourceDir)\SECURITY.md" KeyPath="no" />
        <File Id="LicenseMit" Name="LICENSE-MIT" Source="$(SourceDir)\LICENSE-MIT" KeyPath="no" />
        <File Id="LicenseApache" Name="LICENSE-APACHE" Source="$(SourceDir)\LICENSE-APACHE" KeyPath="no" />
        <RegistryValue Root="HKCU" Key="Software\Chat with Work\Desktop"
          Name="Documents" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts" Directory="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="TuiShortcut" Name="Chat with Work (Terminal)"
          Description="Chat, pair this computer and manage shared folders in the terminal"
          Target="[#CwwExe]" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\Chat with Work\Desktop"
          Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <Component Id="DesktopShortcut">
        <Shortcut Id="AppShortcut" Name="Chat with Work"
          Description="Chat with your assistant and manage shared folders"
          Target="[#CwwAppExe]" WorkingDirectory="INSTALLFOLDER">
          <!--
            The notifications' AppUserModelID (notification-broker), so
            Windows lists them under this app, with its name and icon.
          -->
          <ShortcutProperty Key="System.AppUserModel.ID" Value="com.chatwithwork.desktop" />
        </Shortcut>
        <RegistryValue Root="HKCU" Key="Software\Chat with Work\Desktop"
          Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="Chat with Work Desktop" AllowAbsent="no">
      <ComponentGroupRef Id="Program" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>

    <!--
      Register and remove the per-user daemon without flashing a console
      window (WixQuietExec). cww falls back to a Startup shortcut if Task
      Scheduler is unavailable. Failures are ignored so the app can offer
      Start Background Agent after installation.
    -->
    <SetProperty Id="RegisterDaemon" Value="&quot;[#CwwExe]&quot; daemon install"
      Before="RegisterDaemon" Sequence="execute" />
    <CustomAction Id="RegisterDaemon" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
      DllEntry="WixQuietExec" Execute="deferred" Impersonate="yes" Return="ignore" />
    <SetProperty Id="UnregisterDaemon" Value="&quot;[#CwwExe]&quot; daemon uninstall"
      Before="UnregisterDaemon" Sequence="execute" />
    <CustomAction Id="UnregisterDaemon" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
      DllEntry="WixQuietExec" Execute="deferred" Impersonate="yes" Return="ignore" />
    <SetProperty Id="PurgeDaemon" Value="&quot;[#CwwExe]&quot; daemon uninstall --purge"
      Before="PurgeDaemon" Sequence="execute" />
    <CustomAction Id="PurgeDaemon" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
      DllEntry="WixQuietExec" Execute="deferred" Impersonate="yes" Return="ignore" />
    <!--
      Uninstalling closes the desktop app (its window, tray item, and the
      notification helper the agent started) before Windows would ask to,
      so nothing keeps running from the removed folder. An upgrade by the
      app's own updater has already quit it.
    -->
    <util:CloseApplication Id="CloseDesktopApp" Target="cww-app.exe" CloseMessage="yes"
      EndSessionMessage="yes" TerminateProcess="0" Timeout="5" RebootPrompt="no"
      Condition="REMOVE=&quot;ALL&quot;" />
    <InstallExecuteSequence>
      <Custom Action="UnregisterDaemon" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND UPGRADINGPRODUCTCODE" />
      <Custom Action="PurgeDaemon" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RegisterDaemon" Before="InstallFinalize" Condition="NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
