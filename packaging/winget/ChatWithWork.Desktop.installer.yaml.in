# yaml-language-server: $schema=https://aka.ms/winget-manifest.installer.1.12.0.schema.json
PackageIdentifier: ChatWithWork.Desktop
PackageVersion: @VERSION@
InstallerType: wix
Scope: user
InstallModes:
- interactive
- silent
- silentWithProgress
UpgradeBehavior: install
# The desktop app's window is a WebView2 web view. Windows 11 and current
# Windows 10 have the runtime; WinGet installs it where it's missing.
Dependencies:
  PackageDependencies:
  - PackageIdentifier: Microsoft.EdgeWebView2Runtime
Commands:
- cww
AppsAndFeaturesEntries:
- DisplayName: Chat with Work Desktop
  Publisher: Plenty
  UpgradeCode: '{FBC69B33-161E-40DC-9D83-5B54DB1A9821}'
  InstallerType: wix
Installers:
- Architecture: x64
  InstallerUrl: https://github.com/crmne/chatwithwork-desktop/releases/download/v@VERSION@/Chat-with-Work-Desktop-@VERSION@-Windows-x64.msi
  InstallerSha256: @WINDOWS_X64_MSI_SHA256@
- Architecture: arm64
  InstallerUrl: https://github.com/crmne/chatwithwork-desktop/releases/download/v@VERSION@/Chat-with-Work-Desktop-@VERSION@-Windows-arm64.msi
  InstallerSha256: @WINDOWS_ARM64_MSI_SHA256@
ManifestType: installer
ManifestVersion: 1.12.0
